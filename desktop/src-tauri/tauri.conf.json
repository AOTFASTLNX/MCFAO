{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NCL Builder",
  "version": "0.2.7",
  "identifier": "org.fabricaot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:bundle && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NCL Builder \u00b7 IPA \u6784\u5efa\u5de5\u4f5c\u53f0",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        },
        "backgroundColor": "#F5F5F7",
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "NCL Builder \u672c\u5730 IPA \u6784\u5efa\u5de5\u4f5c\u53f0\uff08\u5b9e\u9a8c\u7248\uff09",
    "resources": {
      "../../tools/preflight.py": "tools/preflight.py",
      "icon-build/Assets.car": "Assets.car",
      "icon-build/NCB.icns": "NCB.icns",
      "../../tools/mod_file_policy.py": "tools/mod_file_policy.py",
      "bundle-source/": "source/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
