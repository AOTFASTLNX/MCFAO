{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FabricAOT",
  "version": "0.1.0",
  "identifier": "org.fabricaot.desktop.integration20261115",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FabricAOT · 本地工作台",
        "width": 1360,
        "height": 940,
        "minWidth": 800,
        "minHeight": 640,
        "backgroundColor": "#101311",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "FabricAOT 本地整合包工作台（实验版）",
    "resources": { "../../tools/preflight.py": "tools/preflight.py" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
